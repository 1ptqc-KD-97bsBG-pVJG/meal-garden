{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meal Garden recipe v1",
  "type": "object",
  "required": ["schema_version", "id", "revision", "title", "readiness"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "readiness": {"enum": ["idea", "candidate", "ready"]},
    "ingredients": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "amount", "unit", "purchase"], "properties": {"amount": {"type": "number", "exclusiveMinimum": 0}, "purchase": {"type": "object", "required": ["unit", "capacity", "label"], "properties": {"capacity": {"type": "number", "exclusiveMinimum": 0}}}}}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "text"], "properties": {"timer_minutes": {"type": "number", "exclusiveMinimum": 0}}}}
  },
  "allOf": [{"if": {"properties": {"readiness": {"const": "ready"}}}, "then": {"required": ["ingredients", "steps", "yield_notes", "equipment"]}}]
}
